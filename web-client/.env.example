# => COPY AND EDIT THIS FILE TO CREATE YOUR CUSTOM .env.*.local FILES, removing this message and the banner above.

# *** DO NOT COMMIT THIS FILE TO SOURCE CONTROL ***

# Use settings like these to create your .env.development|local.local file(s):

# Local development mode deployment.
# NEXT_PUBLIC_WEB_CLIENT_URL=http://localhost:3000
# NEXT_PUBLIC_SERVER_URL=http://localhost:8080/api
# NEXT_PUBLIC_GRAPHQL_ENDPOINT_URL=http://localhost:8080/api/graphql

# Production-mode deployment to a local Tomcat server.
# NEXT_PUBLIC_WEB_CLIENT_URL=http://localhost:8081
# NEXT_PUBLIC_SERVER_URL=http://localhost:8081/api
# NEXT_PUBLIC_GRAPHQL_ENDPOINT_URL=http://localhost:8081/api/graphql

# Use settings like these to create your .env.production.local file:

# Production-mode deployment to a remote production server.
# NEXT_PUBLIC_WEB_CLIENT_URL=https://MY_PRODUCTION_SERVER
# NEXT_PUBLIC_SERVER_URL=https://MY_PRODUCTION_SERVER/api
# NEXT_PUBLIC_GRAPHQL_ENDPOINT_URL=https://MY_PRODUCTION_SERVER/api/graphql
